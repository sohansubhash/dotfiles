[core]
	editor = subl -n -w
[diff]
	tool = smerge
[merge]
	tool = smerge
[push]
	autoSetupRemote = true
[mergetool "smerge"]
	cmd = smerge mergetool "$BASE" "$LOCAL" "$REMOTE" -o "$MERGED"
	trustExitCode = true
[alias]
	br = branch
	co = checkout
	st = status
	ol = log --oneline
	rpo = remote prune origin
	fos = fetch origin staging:staging
	fom = fetch origin master:master
	pushn = push --no-verify
